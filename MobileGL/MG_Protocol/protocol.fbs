//
// Phase 0 draft: unified Message + Payload union. The full payload set is
// generated from the API manifest (see api_manifest.txt) by the codegen
// pipeline; this file keeps the seed cases that define the shapes.

namespace MobileGL.Protocol;

// ---------------------------------------------------------------------------
// Shared memory region: large blobs never travel inside the FlatBuffer.
// ---------------------------------------------------------------------------

table ShmRegion {
    offset: ulong;
    size: ulong;
}

// ---------------------------------------------------------------------------
// EGL command payloads.
// ---------------------------------------------------------------------------

table EglGetDisplay { nativeDisplay: ulong; }
table EglInitialize { display: ulong; }
table EglTerminate { display: ulong; }
table EglBindAPI { api: uint; }
table EglChooseConfig { display: ulong; nativeConfigAttribs: [uint]; configCountRequested: uint; }
table EglCreateContext { display: ulong; config: ulong; shareContext: ulong; attribs: [uint]; }
table EglCreateWindowSurface { display: ulong; config: ulong; nativeWindow: ulong; attribs: [uint]; }
table EglCreatePbufferSurface { display: ulong; config: ulong; width: int; height: int; attribs: [uint]; }
table EglDestroySurface { display: ulong; surface: ulong; }
table EglMakeCurrent { display: ulong; drawSurface: ulong; readSurface: ulong; context: ulong; }
table EglSwapBuffers { display: ulong; surface: ulong; }
table EglSwapInterval { display: ulong; interval: int; }
table EglGetError { }
table EglGetProcAddress { name: string; }
table EglQueryString { display: ulong; name: uint; }
table EglQuerySurface { display: ulong; surface: ulong; attribute: uint; }
table EglDestroyContext { display: ulong; context: ulong; }
table EglReleaseThread { }

// ---------------------------------------------------------------------------
// GL command payloads. Pointer arguments are carried either inline
// ([ubyte]) or via ShmRegion; the codegen decides per API category.
// ---------------------------------------------------------------------------

table GlClear { mask: uint; }
table GlClearColor { red: float; green: float; blue: float; alpha: float; }
table GlClearDepth { depth: double; }
table GlClearStencil { s: int; }
table GlDrawArrays { mode: uint; first: int; count: int; }
table GlDrawElements { mode: uint; count: int; type: uint; indicesShm: ShmRegion; }
table GlDrawElementsBaseVertex { mode: uint; count: int; type: uint; indicesShm: ShmRegion; baseVertex: int; }
table GlDrawArraysInstanced { mode: uint; first: int; count: int; instanceCount: int; }
table GlDrawElementsInstanced { mode: uint; count: int; type: uint; indicesShm: ShmRegion; instanceCount: int; }
table GlMultiDrawArrays { mode: uint; firstShm: ShmRegion; countShm: ShmRegion; drawCount: int; }
table GlMultiDrawElements { mode: uint; countShm: ShmRegion; type: uint; indicesShm: ShmRegion; drawCount: int; }
table GlMultiDrawElementsIndirect { mode: uint; type: uint; indirectShm: ShmRegion; drawCount: int; stride: int; }
table GlMultiDrawArraysIndirect { mode: uint; indirectShm: ShmRegion; drawCount: int; stride: int; }

table GlEnable { cap: uint; }
table GlDisable { cap: uint; }
table GlViewport { x: int; y: int; width: int; height: int; }
table GlScissor { x: int; y: int; width: int; height: int; }
table GlDepthFunc { func: uint; }
table GlDepthMask { flag: bool; }
table GlColorMask { red: bool; green: bool; blue: bool; alpha: bool; }
table GlStencilFunc { func: uint; ref: int; mask: uint; }
table GlStencilOp { fail: uint; zfail: uint; zpass: uint; }
table GlBlendFunc { sfactor: uint; dfactor: uint; }
table GlBlendFuncSeparate { sfactorRgb: uint; dfactorRgb: uint; sfactorAlpha: uint; dfactorAlpha: uint; }
table GlBlendEquation { mode: uint; }
table GlBlendEquationSeparate { modeRgb: uint; modeAlpha: uint; }
table GlCullFace { mode: uint; }
table GlFrontFace { mode: uint; }
table GlLineWidth { width: float; }
table GlPolygonOffset { factor: float; units: float; }
table GlPixelStorei { pname: uint; param: int; }
table GlActiveTexture { texture: uint; }
table GlFinish { }
table GlFlush { }

table GlBindBuffer { target: uint; buffer: uint; }
table GlDeleteBuffers { buffers: [uint]; }
table GlGenBuffers { count: int; }
table GlIsBuffer { buffer: uint; }
table GlBufferData { target: uint; size: ulong; dataShm: ShmRegion; usage: uint; }
table GlBufferSubData { target: uint; offset: ulong; size: ulong; dataShm: ShmRegion; }
table GlGetBufferSubData { target: uint; offset: ulong; size: ulong; }
table GlMapBuffer { target: uint; access: uint; }
table GlMapBufferRange { target: uint; offset: ulong; length: ulong; access: uint; }
table GlUnmapBuffer { target: uint; }
table GlFlushMappedBufferRange { target: uint; offset: ulong; length: ulong; }
table GlBindBufferRange { target: uint; index: uint; buffer: uint; offset: ulong; size: ulong; }
table GlBindBufferBase { target: uint; index: uint; buffer: uint; }

table GlBindTexture { target: uint; texture: uint; }
table GlDeleteTextures { textures: [uint]; }
table GlGenTextures { count: int; }
table GlIsTexture { texture: uint; }
table GlTexImage2D { target: uint; level: int; internalFormat: int; width: int; height: int; border: int; format: uint; type: uint; dataShm: ShmRegion; }
table GlTexSubImage2D { target: uint; level: int; xoffset: int; yoffset: int; width: int; height: int; format: uint; type: uint; dataShm: ShmRegion; }
table GlCompressedTexImage2D { target: uint; level: int; internalFormat: uint; width: int; height: int; border: int; imageSize: int; dataShm: ShmRegion; }
table GlGenerateMipmap { target: uint; }
table GlTexParameteri { target: uint; pname: uint; param: int; }
table GlTexParameterf { target: uint; pname: uint; param: float; }
table GlSamplerParameteri { sampler: uint; pname: uint; param: int; }
table GlSamplerParameterf { sampler: uint; pname: uint; param: float; }
table GlBindSampler { unit: uint; sampler: uint; }
table GlGenSamplers { count: int; }
table GlDeleteSamplers { samplers: [uint]; }

table GlBindFramebuffer { target: uint; framebuffer: uint; }
table GlGenFramebuffers { count: int; }
table GlDeleteFramebuffers { framebuffers: [uint]; }
table GlFramebufferTexture2D { target: uint; attachment: uint; textarget: uint; texture: uint; level: int; }
table GlFramebufferRenderbuffer { target: uint; attachment: uint; renderbuffertarget: uint; renderbuffer: uint; }
table GlRenderbufferStorage { target: uint; internalFormat: uint; width: int; height: int; }
table GlBindRenderbuffer { target: uint; renderbuffer: uint; }
table GlGenRenderbuffers { count: int; }
table GlDeleteRenderbuffers { renderbuffers: [uint]; }
table GlCheckFramebufferStatus { target: uint; }
table GlFramebufferTextureLayer { target: uint; attachment: uint; texture: uint; level: int; layer: int; }

table GlBindVertexArray { array: uint; }
table GlGenVertexArrays { count: int; }
table GlDeleteVertexArrays { arrays: [uint]; }
table GlVertexAttribPointer { index: uint; size: int; type: uint; normalized: bool; stride: int; pointerShm: ShmRegion; }
table GlEnableVertexAttribArray { index: uint; }
table GlDisableVertexAttribArray { index: uint; }
table GlVertexAttribDivisor { index: uint; divisor: uint; }

table GlCreateShader { type: uint; }
table GlShaderSource { shader: uint; sourceShm: ShmRegion; }
table GlCompileShader { shader: uint; }
table GlCreateProgram { }
table GlAttachShader { program: uint; shader: uint; }
table GlDetachShader { program: uint; shader: uint; }
table GlDeleteProgram { program: uint; }
table GlDeleteShader { shader: uint; }
table GlLinkProgram { program: uint; }
table GlUseProgram { program: uint; }
table GlBindAttribLocation { program: uint; index: uint; nameShm: ShmRegion; }
table GlUniform1i { location: int; v0: int; }
table GlUniform1f { location: int; v0: float; }
table GlUniform2f { location: int; v0: float; v1: float; }
table GlUniform3f { location: int; v0: float; v1: float; v2: float; }
table GlUniform4f { location: int; v0: float; v1: float; v2: float; v3: float; }
table GlUniformMatrix4fv { location: int; count: int; transpose: bool; valueShm: ShmRegion; }
table GlGetUniformLocation { program: uint; nameShm: ShmRegion; }
table GlGetAttribLocation { program: uint; nameShm: ShmRegion; }
table GlGetActiveUniform { program: uint; index: uint; }

table GlReadPixels { x: int; y: int; width: int; height: int; format: uint; type: uint; pixelsShm: ShmRegion; }
table GlGetTexImage { target: uint; level: int; format: uint; type: uint; pixelsShm: ShmRegion; }
table GlGetIntegerv { pname: uint; }
table GlGetFloatv { pname: uint; }
table GlGetBooleanv { pname: uint; }
table GlGetString { name: uint; }
table GlGetStringi { name: uint; index: uint; }
table GlGetError { }
table GlGetProgramiv { program: uint; pname: uint; }
table GlGetProgramInfoLog { program: uint; bufSize: int; }
table GlGetShaderiv { shader: uint; pname: uint; }
table GlGetShaderInfoLog { shader: uint; bufSize: int; }
table GlGetBufferParameteriv { target: uint; pname: uint; }
table GlGetVertexAttribiv { index: uint; pname: uint; }
table GlGetVertexAttribfv { index: uint; pname: uint; }

table GlQueryCounterTimestamp { }
table GlBeginQuery { target: uint; id: uint; }
table GlEndQuery { target: uint; }
table GlGenQueries { count: int; }
table GlDeleteQueries { ids: [uint]; }
table GlGetQueryiv { target: uint; pname: uint; }
table GlGetQueryObjectuiv { id: uint; pname: uint; }
table GlFenceSync { condition: uint; flags: uint; }
table GlDeleteSync { sync: ulong; }
table GlClientWaitSync { sync: ulong; flags: uint; timeout: ulong; }
table GlWaitSync { sync: ulong; flags: uint; timeout: ulong; }

table GlDrawBuffers { buffers: [uint]; }
table GlReadBuffer { src: uint; }
table GlBlitFramebuffer { srcX0: int; srcY0: int; srcX1: int; srcY1: int; dstX0: int; dstY0: int; dstX1: int; dstY1: int; mask: uint; filter: uint; }
table GlCopyTexImage2D { target: uint; level: int; internalFormat: int; x: int; y: int; width: int; height: int; border: int; }
table GlCopyTexSubImage2D { target: uint; level: int; xoffset: int; yoffset: int; x: int; y: int; width: int; height: int; }
table GlMemoryBarrier { barriers: uint; }
table GlDispatchCompute { numGroupsX: uint; numGroupsY: uint; numGroupsZ: uint; }
table GlBindImageTexture { unit: uint; texture: uint; level: int; layered: bool; layer: int; access: uint; format: uint; }
table GlBeginTransformFeedback { primitiveMode: uint; }
table GlEndTransformFeedback { }
table GlTransformFeedbackVaryings { program: uint; varyingsShm: ShmRegion; bufferMode: uint; }

// @INSERTION_POINT:PAYLOAD_CASES@

// ---------------------------------------------------------------------------
// Payload union. Order is significant: opcode == union case index.
// ---------------------------------------------------------------------------

union Payload {
    EglGetDisplay,
    EglInitialize,
    EglTerminate,
    EglBindAPI,
    EglChooseConfig,
    EglCreateContext,
    EglCreateWindowSurface,
    EglCreatePbufferSurface,
    EglDestroySurface,
    EglMakeCurrent,
    EglSwapBuffers,
    EglSwapInterval,
    EglGetError,
    EglGetProcAddress,
    EglQueryString,
    EglQuerySurface,
    EglDestroyContext,
    EglReleaseThread,

    GlClear,
    GlClearColor,
    GlClearDepth,
    GlClearStencil,
    GlDrawArrays,
    GlDrawElements,
    GlDrawElementsBaseVertex,
    GlDrawArraysInstanced,
    GlDrawElementsInstanced,
    GlMultiDrawArrays,
    GlMultiDrawElements,
    GlMultiDrawElementsIndirect,
    GlMultiDrawArraysIndirect,
    GlEnable,
    GlDisable,
    GlViewport,
    GlScissor,
    GlDepthFunc,
    GlDepthMask,
    GlColorMask,
    GlStencilFunc,
    GlStencilOp,
    GlBlendFunc,
    GlBlendFuncSeparate,
    GlBlendEquation,
    GlBlendEquationSeparate,
    GlCullFace,
    GlFrontFace,
    GlLineWidth,
    GlPolygonOffset,
    GlPixelStorei,
    GlActiveTexture,
    GlFinish,
    GlFlush,

    GlBindBuffer,
    GlDeleteBuffers,
    GlGenBuffers,
    GlIsBuffer,
    GlBufferData,
    GlBufferSubData,
    GlGetBufferSubData,
    GlMapBuffer,
    GlMapBufferRange,
    GlUnmapBuffer,
    GlFlushMappedBufferRange,
    GlBindBufferRange,
    GlBindBufferBase,

    GlBindTexture,
    GlDeleteTextures,
    GlGenTextures,
    GlIsTexture,
    GlTexImage2D,
    GlTexSubImage2D,
    GlCompressedTexImage2D,
    GlGenerateMipmap,
    GlTexParameteri,
    GlTexParameterf,
    GlSamplerParameteri,
    GlSamplerParameterf,
    GlBindSampler,
    GlGenSamplers,
    GlDeleteSamplers,

    GlBindFramebuffer,
    GlGenFramebuffers,
    GlDeleteFramebuffers,
    GlFramebufferTexture2D,
    GlFramebufferRenderbuffer,
    GlRenderbufferStorage,
    GlBindRenderbuffer,
    GlGenRenderbuffers,
    GlDeleteRenderbuffers,
    GlCheckFramebufferStatus,
    GlFramebufferTextureLayer,

    GlBindVertexArray,
    GlGenVertexArrays,
    GlDeleteVertexArrays,
    GlVertexAttribPointer,
    GlEnableVertexAttribArray,
    GlDisableVertexAttribArray,
    GlVertexAttribDivisor,

    GlCreateShader,
    GlShaderSource,
    GlCompileShader,
    GlCreateProgram,
    GlAttachShader,
    GlDetachShader,
    GlDeleteProgram,
    GlDeleteShader,
    GlLinkProgram,
    GlUseProgram,
    GlBindAttribLocation,
    GlUniform1i,
    GlUniform1f,
    GlUniform2f,
    GlUniform3f,
    GlUniform4f,
    GlUniformMatrix4fv,
    GlGetUniformLocation,
    GlGetAttribLocation,
    GlGetActiveUniform,

    GlReadPixels,
    GlGetTexImage,
    GlGetIntegerv,
    GlGetFloatv,
    GlGetBooleanv,
    GlGetString,
    GlGetStringi,
    GlGetError,
    GlGetProgramiv,
    GlGetProgramInfoLog,
    GlGetShaderiv,
    GlGetShaderInfoLog,
    GlGetBufferParameteriv,
    GlGetVertexAttribiv,
    GlGetVertexAttribfv,

    GlQueryCounterTimestamp,
    GlBeginQuery,
    GlEndQuery,
    GlGenQueries,
    GlDeleteQueries,
    GlGetQueryiv,
    GlGetQueryObjectuiv,
    GlFenceSync,
    GlDeleteSync,
    GlClientWaitSync,
    GlWaitSync,

    GlDrawBuffers,
    GlReadBuffer,
    GlBlitFramebuffer,
    GlCopyTexImage2D,
    GlCopyTexSubImage2D,
    GlMemoryBarrier,
    GlDispatchCompute,
    GlBindImageTexture,
    GlBeginTransformFeedback,
    GlEndTransformFeedback,
    GlTransformFeedbackVaryings
}

// ---------------------------------------------------------------------------
// Envelope. sessionId/clientThreadId/seq identify the per-thread FIFO stream.
// ---------------------------------------------------------------------------

enum CommandFlags : uint {
    None = 0,
    Batch = 1,
    Sync = 2,
    HasPayloadShm = 4,
    HasResponse = 8
}

table Command {
    sessionId: ulong;
    clientThreadId: uint;
    seq: uint;
    flags: uint;
    opcode: ushort;
    payload: Payload;
    payloadShm: ShmRegion;
}

table Message {
    version: uint;
    command: Command;
}

root_type Message;

// ---------------------------------------------------------------------------
// Response types (server -> client). A second root for responses is generated
// from this schema as `Response` by the codegen; flatc keeps one root_type
// per schema, so the server builder uses the Response table directly.
// ---------------------------------------------------------------------------

table EglGetErrorResponse { errorCode: int; }
table EglGetConfigAttribResponse { value: int; }
table EglQueryStringResponse { value: string; }
table EglQuerySurfaceResponse { value: int; }

table GlGetErrorResponse { glError: uint; }
table GlGetIntegervResponse { data: [int]; }
table GlGetFloatvResponse { data: [float]; }
table GlGetBooleanvResponse { data: [bool]; }
table GlGetStringResponse { value: string; }
table GlGetStringiResponse { value: string; }
table GlGenTexturesResponse { names: [uint]; }
table GlGenBuffersResponse { names: [uint]; }
table GlGenFramebuffersResponse { names: [uint]; }
table GlGenRenderbuffersResponse { names: [uint]; }
table GlGenVertexArraysResponse { names: [uint]; }
table GlGenSamplersResponse { names: [uint]; }
table GlGenQueriesResponse { ids: [uint]; }
table GlGetUniformLocationResponse { location: int; }
table GlGetAttribLocationResponse { location: int; }
table GlGetProgramivResponse { data: [int]; }
table GlGetShaderivResponse { data: [int]; }
table GlGetBufferParameterivResponse { data: [int]; }
table GlGetVertexAttribivResponse { data: [int]; }
table GlGetVertexAttribfvResponse { data: [float]; }
table GlGetProgramInfoLogResponse { log: string; }
table GlGetShaderInfoLogResponse { log: string; }
table GlCheckFramebufferStatusResponse { status: uint; }
table GlIsTextureResponse { value: bool; }
table GlIsBufferResponse { value: bool; }
table GlIsProgramResponse { value: bool; }
table GlIsShaderResponse { value: bool; }
table GlIsFramebufferResponse { value: bool; }
table GlIsRenderbufferResponse { value: bool; }
table GlIsVertexArrayResponse { value: bool; }
table GlIsSamplerResponse { value: bool; }
table GlIsQueryResponse { value: bool; }
table GlIsEnabledResponse { value: bool; }
table GlMapBufferResponse { shmRegion: ShmRegion; }
table GlMapBufferRangeResponse { shmRegion: ShmRegion; }
table GlReadPixelsResponse { shmRegion: ShmRegion; }
table GlGetTexImageResponse { shmRegion: ShmRegion; }
table GlGetBufferSubDataResponse { shmRegion: ShmRegion; }
table GlClientWaitSyncResponse { result: uint; }
table GlFenceSyncResponse { sync: ulong; }
table GlCreateShaderResponse { shader: uint; }
table GlCreateProgramResponse { program: uint; }
table GlUnmapBufferResponse { success: bool; }

union ReturnValue {
    EglGetErrorResponse,
    EglGetConfigAttribResponse,
    EglQueryStringResponse,
    EglQuerySurfaceResponse,
    GlGetErrorResponse,
    GlGetIntegervResponse,
    GlGetFloatvResponse,
    GlGetBooleanvResponse,
    GlGetStringResponse,
    GlGetStringiResponse,
    GlGenTexturesResponse,
    GlGenBuffersResponse,
    GlGenFramebuffersResponse,
    GlGenRenderbuffersResponse,
    GlGenVertexArraysResponse,
    GlGenSamplersResponse,
    GlGenQueriesResponse,
    GlGetUniformLocationResponse,
    GlGetAttribLocationResponse,
    GlGetProgramivResponse,
    GlGetShaderivResponse,
    GlGetBufferParameterivResponse,
    GlGetVertexAttribivResponse,
    GlGetVertexAttribfvResponse,
    GlGetProgramInfoLogResponse,
    GlGetShaderInfoLogResponse,
    GlCheckFramebufferStatusResponse,
    GlIsTextureResponse,
    GlIsBufferResponse,
    GlIsProgramResponse,
    GlIsShaderResponse,
    GlIsFramebufferResponse,
    GlIsRenderbufferResponse,
    GlIsVertexArrayResponse,
    GlIsSamplerResponse,
    GlIsQueryResponse,
    GlIsEnabledResponse,
    GlMapBufferResponse,
    GlMapBufferRangeResponse,
    GlReadPixelsResponse,
    GlGetTexImageResponse,
    GlGetBufferSubDataResponse,
    GlClientWaitSyncResponse,
    GlFenceSyncResponse,
    GlCreateShaderResponse,
    GlCreateProgramResponse,
    GlUnmapBufferResponse
}

enum ResponseStatus : uint {
    Ok = 0,
    GLError = 1,
    ProtocolError = 2
}

table Response {
    seq: uint;
    status: ResponseStatus;
    errorCode: int;
    ret: ReturnValue;
    retShm: ShmRegion;
}

// End of File
