table EglCreatePbufferSurface { display: ulong; config: ulong; width: int; height: int; attribs: [uint]; }
table EglDestroySurface { display: ulong; surface: ulong; }
table EglMakeCurrent { display: ulong; drawSurface: ulong; readSurface: ulong; context: ulong; }
table EglSwapBuffers { display: ulong; surface: ulong; }
table EglSwapInterval { display: ulong; interval: int; }
table EglGetError { }
table EglGetProcAddress { name: string; }
table EglQueryString { display: ulong; name: uint; }
table EglQuerySurface { display: ulong; surface: ulong; attribute: uint; }
table EglDestroyContext { display: ulong; context: ulong; }
table EglReleaseThread { }

