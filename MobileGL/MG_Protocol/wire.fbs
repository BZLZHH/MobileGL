//
// Minimal wire schema used by the current Client <-> FullServer transport.
// The full API surface lives in protocol.fbs + protocol_generated.fbs and is
// merged into this schema by the Phase 4 codegen as APIs land.

namespace MobileGL.Protocol.Wire;

table GlClear {
    mask: uint;
}

table DataBlob {
    offset: ulong;
    size: ulong;
}

table Command {
    opcode: uint;
    session_id: ulong;
    token: ulong;
    clear: GlClear;
    data: DataBlob;
}

table Message {
    command: Command;
    shm_count: uint;
}

table Response {
    status: uint;
    token: ulong;
    data_byte: uint;
}

root_type Message;
