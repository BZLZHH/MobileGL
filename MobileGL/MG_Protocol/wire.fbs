// Minimal wire schema used by the current Client <-> FullServer transport.
// The full API surface lives in protocol.fbs + protocol_generated.fbs and is
// merged into this schema by the Phase 4 codegen as APIs land.

namespace MobileGL.Protocol.Wire;

table GlClear {
    mask: uint;
}

table ClearColor {
    red: float;
    green: float;
    blue: float;
    alpha: float;
}

table DrawArrays {
    mode: uint;
    first: int;
    count: int;
}

table DrawElements {
    mode: uint;
    count: int;
    type: uint;
    indices_offset: ulong;
}

table BufferSubData {
    buffer_handle: ulong;
    offset: ulong;
    size: ulong;
}

table MemoryBarrier {
    barriers: uint;
}

table MemoryBarrierByRegion {
    barriers: uint;
}

table PatchParameteri {
    pname: uint;
    value: int;
}

table GenerateMipmap {
    target: uint;
}

table DispatchCompute {
    num_groups_x: uint;
    num_groups_y: uint;
    num_groups_z: uint;
}

table BeginTransformFeedback {
    primitive_mode: uint;
}

table BindTransformFeedback {
    name: uint;
}

table BlitFramebuffer {
    read_framebuffer: ulong;
    draw_framebuffer: ulong;
    src_x0: int;
    src_y0: int;
    src_x1: int;
    src_y1: int;
    dst_x0: int;
    dst_y0: int;
    dst_x1: int;
    dst_y1: int;
    mask: uint;
    filter: uint;
}

table SwapBuffers {
    draw: ulong;
}

table DispatchComputeIndirect {
    indirect_offset: ulong;
}

table FenceSync {
    condition: uint;
    flags: uint;
}

table DeleteSync {
    sync: ulong;
}

table WaitSync {
    sync: ulong;
    flags: uint;
    timeout: ulong;
}

table DrawArraysInstanced {
    mode: uint;
    first: int;
    count: int;
    primcount: int;
}

table DrawElementsInstanced {
    mode: uint;
    count: int;
    type: uint;
    indices_offset: ulong;
    instance_count: int;
}

table DrawRangeElements {
    mode: uint;
    start: uint;
    end: uint;
    count: int;
    type: uint;
    indices_offset: ulong;
}

table BufferRespecify {
    buffer_handle: ulong;
    size: ulong;
    usage: uint;
}

table DrawArraysIndirect {
    mode: uint;
    shm_offset: ulong;
}

table DrawElementsIndirect {
    mode: uint;
    type: uint;
    shm_offset: ulong;
}

table GetString {
    pname: uint;
}

table TextureRespecify {
    texture: ulong;
    level: uint;
    format: uint;
    type: uint;
    width: uint;
    height: uint;
    depth: uint;
    data_size: ulong;
}

table ReadPixels {
    x: int;
    y: int;
    width: int;
    height: int;
    format: uint;
    type: uint;
}

table DataBlob {
    offset: ulong;
    size: ulong;
}

table Command {
    opcode: uint;
    session_id: ulong;
    token: ulong;
    clear: GlClear;
    clear_color: ClearColor;
    draw_arrays: DrawArrays;
    draw_elements: DrawElements;
    buffer_sub_data: BufferSubData;
    memory_barrier: MemoryBarrier;
    memory_barrier_by_region: MemoryBarrierByRegion;
    patch_parameteri: PatchParameteri;
    generate_mipmap: GenerateMipmap;
    dispatch_compute: DispatchCompute;
    begin_transform_feedback: BeginTransformFeedback;
    bind_transform_feedback: BindTransformFeedback;
    blit_framebuffer: BlitFramebuffer;
    swap_buffers: SwapBuffers;
    data: DataBlob;
    dispatch_compute_indirect: DispatchComputeIndirect;
    fence_sync: FenceSync;
    delete_sync: DeleteSync;
    wait_sync: WaitSync;
    draw_arrays_instanced: DrawArraysInstanced;
    draw_elements_instanced: DrawElementsInstanced;
    draw_range_elements: DrawRangeElements;
    buffer_respecify: BufferRespecify;
    draw_arrays_indirect: DrawArraysIndirect;
    draw_elements_indirect: DrawElementsIndirect;
    get_string: GetString;
    texture_respecify: TextureRespecify;
    read_pixels: ReadPixels;
}

table Message {
    command: Command;
    shm_count: uint;
}

table Response {
    status: uint;
    token: ulong;
    data_byte: uint;
    sync: ulong;
    string_value: string;
    ret_shm_count: uint;
}

root_type Message;
